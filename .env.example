# Run `npm run setup` to generate a secure `.env` for this checkout.

# Enables operational token mint/revoke endpoints. Generate with: openssl rand -base64 32
ADMIN__SECRET=

# Signs login sessions. Generate with: openssl rand -base64 32
# Required in production and stable across restarts; development generates one per boot when unset.
AUTH__SECRET=

# Unset uses embedded PGLite at ./data/pglite. Also accepts pglite://memory or Postgres.
# One process owns a PGLite directory; several processes may share Postgres (and must share one object store).
# DATABASE_URL=pglite://./data/pglite

# Public origin and listening port. APP__HMR_PORT defaults to APP__PORT + 1.
# APP__PUBLIC_BASE_URL is the one canonical origin every link is minted from; required in production.
# The port comes from APP__PORT, else this URL's port, else 3030.
APP__PUBLIC_BASE_URL=http://app.lvh.me:3030
# Optional dedicated origin that serves only anonymous cached bytes at /assets/*.
# Production requires a distinct HTTPS hostname; HTTP is accepted only on loopback.
# APP__ASSETS_ORIGIN=https://assets.example.com
# Other origins this same deployment answers at (a marketing hostname that proxies
# here, a previous name). Comma-separated; HTTPS, or HTTP on loopback; no path or
# credentials. Served at GET /api/server, so afbin treats a link or a folder from
# either name as this server; requests and credentials still go to
# APP__PUBLIC_BASE_URL alone. A malformed entry refuses the boot.
# APP__ALIAS_ORIGINS=https://example.com
# The IP addresses this deployment's outbound traffic leaves from (web ingestion, webhooks).
# Comma-separated IPv4 or IPv6; served at GET /api/outbound-ips so owners know what to allow in a firewall. Unset serves an empty list; a malformed entry refuses the boot.
# APP__OUTBOUND_IPS=203.0.113.10
# REQUIRED. Every document is served on its own origin, <hex id>.<this host>, framed by the app page.
# A bare hostname; scheme and port follow APP__PUBLIC_BASE_URL. Unset refuses the boot. Over https it may be
# a registrable domain of its own (recommended in production; the frame's cookie is SameSite=None; Partitioned),
# with wildcard DNS and TLS for *.<host>. Over plain http the app must be on the same site (SameSite=Lax).
# Development: lvh.me, browsing the app at http://app.lvh.me:<port> (npm run setup writes both).
APP__PAGES_HOST=lvh.me
APP__PORT=3030
# APP__HOST=
APP__HMR_PORT=

# Per-token artifact cap; 0 disables the cap.
QUOTA__ARTIFACTS_PER_TOKEN=1000

# Stored assets per account (uploads + URLs imported first), 10 GB; anonymous tokens have their own cap. 0 disables.
# ASSETS__MAX_BYTES_PER_TOKEN=10000000000

# Local development writes login mail to .artifactbin/dev-mail.jsonl; read a code with:
#   npm run dev:otp -- you@example.com
# Optional override for standalone processes and test orchestration.
# EMAIL__DEV_OUTBOX_PATH=
# Public email-code login uses either SMTP or Resend with an authorized sender.
EMAIL__RESEND_API_KEY=
# SMTP alternative: default port 587 requires STARTTLS; secure=true uses implicit TLS (default 465).
EMAIL__SMTP_HOST=
EMAIL__SMTP_PORT=
EMAIL__SMTP_SECURE=
EMAIL__SMTP_USER=
EMAIL__SMTP_PASSWORD=
EMAIL__FROM=artifactbin <login@example.com>
# The product name sign-in mail names (subject and body), for an install presented under another name; plain text, one
# line, at most 60 characters. Unset: artifactbin. Invalid: no boot.
# APP__NAME=Acme Data

# Unset S3_URL stores objects locally. Percent-encode credentials in S3 URLs.
# S3_URL=s3://KEY:SECRET@s3.region.amazonaws.com/bucket/prefix?region=region
OBJECT_STORE__LOCAL_DIR=.artifact-objects

IMAGES__MAX_BYTES=50000000
PDF__MAX_BYTES=50000000
FILES__MAX_BYTES=50000000

# Web imports block private networks by default.
WEB_INGEST__ALLOW_PRIVATE=0
WEB_INGEST__TIMEOUT_MS=10000
WEB_INGEST__MAX_PER_HOUR=300

SQL__MAX_ROWS=10000
SQL__MAX_QUERY_ROWS=10000
SQL__QUERY_TIMEOUT_MS=5000

# Number of trusted forwarding hops in front of this app: they set X-Forwarded-For/-Host/-Proto, read that many
# entries from the end. 0: no proxy, so those headers are ignored and Host is the addressed host (anonymous
# readers then share one rate-limit bucket: no address identifies them).
HTTP__TRUSTED_PROXY_HOPS=1

# Optional deployment controls.
# ARTIFACTS__ALLOW_PUBLIC=1
# Anonymous user/group publishing hosts. Off by default; a bare hostname. Each live user or group handle
# (underscores become hyphens) gets <handle>.<this host>: public HTML on its home, unlisted by ID only (noindex,
# no-referrer). Every request there is a guest's, cookies or not: sql reads only.
# Wildcard DNS and TLS for it are the operator's; the product never provisions a hostname.
# APP__USER_PAGES_HOST=u.example.com
# A custom shell: one HTML file this process can read, served (200, no-store, the app's CSP, a Link rel="help" to
# /llms.txt) in place of the app's own screens: exactly the addresses the URL map calls screens (/af/url-space.json,
# contracts isScreenPath): /, every app screen, the page and handle screens /a/<id>, /a/<id>/edit, /@<handle> and
# /@<handle>/<slug>, /login for a browser without a session (with one, /login sends it to its same-origin callbackUrl),
# and every address the app does not otherwise serve, so it can route client-side. The app keeps the rest: the API,
# /af/, old addresses, every other fixed path (OAuth and its consent page, /llms, /welcome, /start, /local/connect,
# ...), every door under /a/<id>/, the installed app /a/<id>/app/ and export captures (?key=); its other screens are
# not reachable. __CSP_NONCE__ inside an attribute value (nonce="...", a meta content) becomes the response's script
# nonce; the first __HEAD_TAGS__ written as markup inside <head> becomes a document's own title, description and
# social card where an anonymous reader may read it (else nothing); any other occurrence (in a script, style,
# comment, text or the body) stays literal. Unreadable: no boot.
# APP__SHELL_FILE=/etc/artifactbin/shell.html
# Skill extras: a flat directory this process can read whose .md guides, .mjs scripts and .json files the author
# skill this origin serves (/skills/artifactbin.zip) carries under extras/, with a generated extras/README.md index
# (each guide needs a "# " heading; a "Read when ..." line is listed too). They are operator instructions and code
# shipped to agents, and public: no secrets. No hidden files, subdirectories or symlinks; 32 files, 64 KiB each,
# 256 KiB in all. Read at boot; invalid: no boot. Enable only once installs run an updater that accepts extras/.
# SKILLS__EXTRA_DIR=/etc/artifactbin/skill-extras
# ANALYTICS__SECRET=

# Services that accept this installation's identity tokens (an identity-side setting; empty by default): each
# an id, the origin its tokens are bound to, and optionally the SHA-256 (hex) of the secret it introspects with
# (POST /api/internal/identity/introspect, answering it only for tokens of its own audience). A person signs in
# for one with `auth.mjs login ... --audience ID` (or OAuth with resource=<origin>); a token for it is never
# accepted by this server's API. A caller already holding a credential here, a signed-in page (same Origin) or an
# ordinary API bearer, exchanges it for a 5-minute token for that service, no refresh token, ending with that
# credential: POST /api/authentication/service-token {"audience":"<id>"}. (/api/authentication/token, the long
# grant, refuses any request a page makes.) Set it on the app and on a separate auth host alike.
# IDENTITY__SERVICE_AUDIENCES=[{"id":"warehouse","origin":"https://data.example.com","introspection_secret_sha256":"<64 hex>"}]
# OAuth clients the operator registers (public, PKCE, no secret): a fixed id and redirects (https, or http on a
# local development host), and a name people see at consent, e.g. a service's web application signing browsers in
# (resource=<its origin>, or this API). "first_party": true makes it part of this deployment's sign-in: no consent
# page, and its grants end when the browser session that approved them ends (sign-out).
# IDENTITY__OAUTH_CLIENTS=[{"client_id":"warehouse-web","name":"Warehouse","redirect_uris":["https://data.example.com/auth/callback"],"first_party":true}]
# The install's default connection: one connector configuration (postgres, mysql; secrets included), which every
# signed-in person may query read-only, from a page (<link rel="af-dataset" data-af-name="NAME" href="default:DB">,
# DB the database the session opens, as written; SQL naming NAME.table) or an agent (sql.mjs query default:DB).
# Give the account read-only grants. "tls": "verify-full" (the default; "ca": a PEM bundle for a private root) or
# "disable". Each statement names its reader inside its own read-only transaction (app.viewer_id, app.viewer_email,
# app.viewer_groups; MySQL @app.viewer_*): advisory on a plain database, since a reader's SQL could change them.
# Shown on the settings page without the user or password. Invalid: no boot (the error names this setting, never
# the value).
# DATASETS__DEFAULT_CONNECTION={"connector":"postgres","host":"db.example.com","database":"shop","user":"reader","password":"..."}
# 1 lets connections reach loopback and private addresses and turn TLS off ("tls":"disable"), for development or a
# database on this install's own network; 0 (the default): public addresses over verified TLS only. Link-local and
# cloud metadata addresses are refused either way.
# DATASETS__ALLOW_PRIVATE_NETWORK=0
# Origins (https, or http on a local development host) allowed to frame a document's address: the /a/<id> app
# page and the document it frames. Only they may frame its embedded view (/a/<id>?embed=1, no app bar). Empty:
# framed by the app alone.
# EMBED__TRUSTED_ORIGINS=
# Group approval of the addresses a page may call: on (the default) or off. On, a group's editors may approve an
# exact https origin a page declares for connect, img or media (never script, style or frame, never a wildcard), and
# every member of the group and its subgroups is then not asked about it on any page. Off: not offered, the group
# addresses API answers group_approvals_disabled, and stored approvals are ignored (kept, not deleted).
# TRUST__GROUP_APPROVALS=on

# Split-service deployment. INTERNAL__SERVICE_SECRET must match across app, SQL, browser and events.
# CONTRACT__ACTOR_SECRET=
# BROWSER__SERVICE_URL=http://browser:8080
# Optional direct export upload: the browser service PUTs each rendered image to the app's signed URL itself.
# The exact HTTPS origin the app's signer emits, and the absolute path ending in /exports/objects/ (path-style
# storage puts the bucket in the path too). The upload gateway gets the same two values and no S3 credentials.
# BROWSER__UPLOAD_ORIGIN=https://bucket.s3.us-west-1.amazonaws.com
# BROWSER__UPLOAD_PREFIX=/artifacts/exports/objects/
# Internal-only browsers reach S3 through the scoped upload gateway (services/browser/src/upload-gateway-server.ts),
# which joins the compute and egress networks, publishes no port, admits only bounded PNG and JPEG PUTs to that
# origin and prefix, and follows no redirect.
# BROWSER__UPLOAD_PROXY_URL=http://upload-gateway:8080
# Browser sessions require Linux bubblewrap with unprivileged user namespaces.
# DEVELOPMENT ONLY. BROWSER__SANDBOX=none runs the session worker as a plain child
# process: no bubblewrap, no cgroup, NO OS containment — a session script then has the
# whole machine, this checkout and the network. It exists so live sessions run on a
# macOS dev host at all; `npm run dev` already defaults it there. It is refused when
# NODE_ENV=production, and any other value is refused outright. Never set it on a server.
# BROWSER__SANDBOX=none
# Split browser service: trusted app URL; also set APP__PUBLIC_BASE_URL, APP__PAGES_HOST and CONTRACT__ACTOR_SECRET there.
# BROWSER__SESSION_APP_URL=http://app:8080
# Writable delegated cgroup v2 subtree with cpu, memory and pids controllers enabled.
# BROWSER__SESSION_CGROUP_ROOT=/sys/fs/cgroup/afbin-sessions
# Live browser sessions this service holds, shared by every owner, and how many one
# credential may hold. Whole numbers of at least 1; each session still gets 1 GiB.
# BROWSER__SESSION_MAX=2
# BROWSER__SESSION_MAX_PER_ACTOR=2
# Auth owner RPC origin for split-host human pages sessions (private service network).
# AUTH__SERVICE_URL=http://auth:3000
# INTERNAL__SERVICE_SECRET=
# SQL__SERVICE_URL=http://sql:8080
# Events use the local database unless an HTTP service URL is configured.
# EVENTS__SERVICE_URL=http://events:8080
# EVENTS__SCHEMA=events
EXPORT__INTERNAL_ORIGIN=

# Optional database schema names. AUTH__SCHEMA also holds the identity module's tables (users, tokens,
# groups …); IDENTITY__SCHEMA is the identity read views every reader (this app, other services) reads them through.
# AUTH__SCHEMA=auth
# APP__SCHEMA=app
# IDENTITY__SCHEMA=identity

# Optional Google login.
# AUTH__GOOGLE_CLIENT_ID=
# AUTH__GOOGLE_CLIENT_SECRET=

# Optional OIDC login. Use explicit endpoints or discovery, not both.
# AUTH__OIDC_PROVIDER_ID=oidc
# AUTH__OIDC_CLIENT_ID=
# AUTH__OIDC_CLIENT_SECRET=
# AUTH__OIDC_AUTHORIZATION_URL=
# AUTH__OIDC_TOKEN_URL=
# AUTH__OIDC_USERINFO_URL=
# AUTH__OIDC_DISCOVERY_URL=




# Company hosting requires a designated verified bootstrap owner.
APP__DEPLOYMENT_MODE=public
APP__DEPLOYMENT_OWNER_EMAIL=
AUTH__INVITE_ONLY=true
AUTH__ALLOWED_EMAIL_PATTERNS=*
# Test-domain accounts for automated runs (the agent evals): with both set, any address at exactly TEST_DOMAIN
# (not a subdomain or a look-alike) signs in with TEST_DOMAIN_OTP through the normal login and receives no mail;
# the code is single use with five attempts and the usual rate limits. New rows are marked users.test_account and
# boxed in (services/app/lib/accounts/test-accounts.ts). Either unset = off; an invalid pair is off and logged.
# The identity service and the app both read the pair: give a split deployment the same values in both.
# TEST_DOMAIN_OTP: 32-128 characters of A-Z a-z 0-9 - _ (e.g. openssl rand -hex 32).
# TEST_DOMAIN=
# TEST_DOMAIN_OTP=
