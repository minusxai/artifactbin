# Run `npm run setup` to generate a secure `.env` for this checkout.

# Enables operational token mint/revoke endpoints. Generate with: openssl rand -base64 32
ADMIN__SECRET=

# Signs login sessions. Generate with: openssl rand -base64 32
AUTH__SECRET=

# Unset uses embedded PGLite at ./data/pglite. Also accepts pglite://memory or Postgres.
# DATABASE_URL=pglite://./data/pglite

# Public origin and listening port. APP__HMR_PORT defaults to APP__PORT + 1.
APP__PUBLIC_BASE_URL=http://app.lvh.me:3030
# Optional dedicated origin that serves only anonymous cached bytes at /assets/*.
# Production requires a distinct HTTPS hostname; HTTP is accepted only on loopback.
# APP__ASSETS_ORIGIN=https://assets.example.com
# Other origins this same deployment answers at (a marketing hostname that proxies
# here, a previous name). Comma-separated; HTTPS, or HTTP on loopback; no path or
# credentials. Served at GET /api/server, so afbin treats a link or a folder from
# either name as this server; requests and credentials still go to
# APP__PUBLIC_BASE_URL alone. A malformed entry refuses the boot.
# APP__ALIAS_ORIGINS=https://example.com
# REQUIRED. Every document is served on its own origin, <hex id>.<this host>, framed by the app page.
# A bare hostname under the app's registrable domain (same site), e.g. pages.example.com;
# scheme and port follow APP__PUBLIC_BASE_URL. Unset refuses the boot.
# Development: lvh.me, browsing the app at http://app.lvh.me:<port> (npm run setup writes both).
APP__PAGES_HOST=lvh.me
APP__PORT=3030
# APP__HOST=
APP__HMR_PORT=

# Per-token artifact cap; 0 disables the cap.
QUOTA__ARTIFACTS_PER_TOKEN=1000

# Stored assets per account (uploads + URLs imported first), 10 GB; anonymous tokens have their own cap. 0 disables.
# ASSETS__MAX_BYTES_PER_TOKEN=10000000000

# Local development writes login mail to .artifactbin/dev-mail.jsonl; read a code with:
#   npm run dev:otp -- you@example.com
# Optional override for standalone processes and test orchestration.
# EMAIL__DEV_OUTBOX_PATH=
# Public deployments require a Resend key and verified sender.
EMAIL__RESEND_API_KEY=
EMAIL__FROM=artifactbin <login@example.com>

# Unset S3_URL stores objects locally. Percent-encode credentials in S3 URLs.
# S3_URL=s3://KEY:SECRET@s3.region.amazonaws.com/bucket/prefix?region=region
OBJECT_STORE__LOCAL_DIR=.artifact-objects

IMAGES__MAX_BYTES=50000000
PDF__MAX_BYTES=50000000
FILES__MAX_BYTES=50000000

# Web imports block private networks by default.
WEB_INGEST__ALLOW_PRIVATE=0
WEB_INGEST__TIMEOUT_MS=10000
WEB_INGEST__MAX_PER_HOUR=300

SQL__MAX_ROWS=10000
SQL__MAX_QUERY_ROWS=10000
SQL__QUERY_TIMEOUT_MS=5000

# Number of trusted forwarding hops used to interpret client addresses.
HTTP__TRUSTED_PROXY_HOPS=1

# Optional deployment controls.
# ARTIFACTS__ALLOW_PUBLIC=1
# Custom domains for profiles: the DNS target hostname users point their domain at
# (a CNAME/ALIAS to it, or an A record to its address). Unset or empty turns off
# attaching and verifying only; verified domains keep being served either way.
# FLAG__CUSTOM_DOMAINS=domains.example.com
# ANALYTICS__SECRET=

# Split-service deployment. INTERNAL__SERVICE_SECRET must match across app, SQL, browser and events.
# CONTRACT__ACTOR_SECRET=
# BROWSER__SERVICE_URL=http://browser:8080
# Optional direct export upload; exact S3 origin and export object prefix only.
# BROWSER__UPLOAD_ORIGIN=https://bucket.s3.us-west-1.amazonaws.com
# BROWSER__UPLOAD_PREFIX=/artifacts/exports/objects/
# Internal-only browsers reach S3 through the scoped upload gateway.
# BROWSER__UPLOAD_PROXY_URL=http://upload-gateway:8080
# Browser sessions require Linux bubblewrap with unprivileged user namespaces.
# DEVELOPMENT ONLY. BROWSER__SANDBOX=none runs the session worker as a plain child
# process: no bubblewrap, no cgroup, NO OS containment — a session script then has the
# whole machine, this checkout and the network. It exists so live sessions run on a
# macOS dev host at all; `npm run dev` already defaults it there. It is refused when
# NODE_ENV=production, and any other value is refused outright. Never set it on a server.
# BROWSER__SANDBOX=none
# Split browser service: trusted app URL; also set APP__PUBLIC_BASE_URL, APP__PAGES_HOST and CONTRACT__ACTOR_SECRET there.
# BROWSER__SESSION_APP_URL=http://app:8080
# Writable delegated cgroup v2 subtree with cpu, memory and pids controllers enabled.
# BROWSER__SESSION_CGROUP_ROOT=/sys/fs/cgroup/afbin-sessions
# Live browser sessions this service holds, shared by every owner, and how many one
# credential may hold. Whole numbers of at least 1; each session still gets 1 GiB.
# BROWSER__SESSION_MAX=2
# BROWSER__SESSION_MAX_PER_ACTOR=2
# INTERNAL__SERVICE_SECRET=
# SQL__SERVICE_URL=http://sql:8080
# Events use the local database unless an HTTP service URL is configured.
# EVENTS__SERVICE_URL=http://events:8080
# EVENTS__SCHEMA=events
EXPORT__INTERNAL_ORIGIN=

# Optional database schema names.
# AUTH__SCHEMA=auth
# APP__SCHEMA=app

# Optional Google login.
# AUTH__GOOGLE_CLIENT_ID=
# AUTH__GOOGLE_CLIENT_SECRET=

# Optional OIDC login. Use explicit endpoints or discovery, not both.
# AUTH__OIDC_PROVIDER_ID=oidc
# AUTH__OIDC_CLIENT_ID=
# AUTH__OIDC_CLIENT_SECRET=
# AUTH__OIDC_AUTHORIZATION_URL=
# AUTH__OIDC_TOKEN_URL=
# AUTH__OIDC_USERINFO_URL=
# AUTH__OIDC_DISCOVERY_URL=


# Permit Postgres connections to loopback/private networks (self-hosted deployments only).
# Link-local, metadata, multicast and unspecified destinations remain blocked.
DATASET__ALLOW_PRIVATE_NETWORKS=false
# Optional comma-separated literal DNS server IPs for dataset PostgreSQL host resolution only.
# Empty uses the operating system resolver.
DATASET__DNS_SERVERS=


# CLI-only: global npm installs automatically update after successful connected commands.
# Unset/false enables updates; true disables them.
# CLI__DISABLE_AUTO_UPDATES=false
# Legacy CLI__AUTO_UPDATE=0 also disables automatic updates.
# An explicit pin disables updates; choose the same exact package version in your npx command.
# CLI__VERSION_PIN=

# Runner: unset URL uses the local service. Remote requests require CONTRACT__ACTOR_SECRET.
RUNNER__SERVICE_URL=
# Set a pinned worker image for Docker isolation; unset uses a local child process.
RUNNER__WORKER_IMAGE=
RUNNER__MAX_CONCURRENT=4
# Optional OpenAI-compatible endpoint and host-only key (blank is supported).
RUNNER__OPENAI_BASE_URL=
RUNNER__OPENAI_API_KEY=
RUNNER__MODEL=
# Explicit completion-limit field: max_completion_tokens (OpenAI), max_tokens (Fireworks).
RUNNER__OUTPUT_TOKEN_FIELD=max_completion_tokens
RUNNER__MAX_OUTPUT_TOKENS=8192
# Standalone runner controller settings.
RUNNER__PORT=3050
RUNNER__DATA_DIR=./data/runner
RUNNER__ARTIFACTBIN_BASE_URL=

# Optional external managed-agent service; requires CONTRACT__ACTOR_SECRET.
# Leave empty to use only agents connected by your own users.
HOSTED_AGENT__SERVICE_URL=
