# Run `npm run setup` to generate a secure `.env` for this checkout.

# Enables operational token mint/revoke endpoints. Generate with: openssl rand -base64 32
ADMIN__SECRET=

# Signs login sessions. Generate with: openssl rand -base64 32
AUTH__SECRET=

# Unset uses embedded PGLite at ./data/pglite. Also accepts pglite://memory or Postgres.
# DATABASE_URL=pglite://./data/pglite

# Used only by `npm run mint`; defaults to APP__PUBLIC_BASE_URL.
# BASE_URL=http://localhost:3030

# Public origin and listening port. APP__HMR_PORT defaults to APP__PORT + 1.
APP__PUBLIC_BASE_URL=http://localhost:3030
APP__PORT=3030
# APP__HOST=
APP__HMR_PORT=

# Per-token artifact cap; 0 disables the cap.
QUOTA__ARTIFACTS_PER_TOKEN=1000

# Stored bytes one importer may cause (uploads + the URLs it imported first); 0 disables.
# ASSETS__MAX_BYTES_PER_TOKEN=536870912

# Local development writes login mail to .artifactbin/dev-mail.jsonl; read a code with:
#   npm run dev:otp -- you@example.com
# Optional override for standalone processes and test orchestration.
# EMAIL__DEV_OUTBOX_PATH=
# Public deployments require a Resend key and verified sender.
EMAIL__RESEND_API_KEY=
EMAIL__FROM=artifactbin <login@verify.artifactbin.dev>

# Unset S3_URL stores objects locally. Percent-encode credentials in S3 URLs.
# S3_URL=s3://KEY:SECRET@s3.region.amazonaws.com/bucket/prefix?region=region
OBJECT_STORE__LOCAL_DIR=.artifact-objects

IMAGES__MAX_BYTES=5000000
PDF__MAX_BYTES=25000000

# Web imports block private networks by default.
WEB_INGEST__ALLOW_PRIVATE=0
WEB_INGEST__TIMEOUT_MS=10000
WEB_INGEST__MAX_PER_HOUR=300
WEB_INGEST__MAX_IMAGES_PER_PUBLISH=8
WEB_INGEST__MAX_ASSETS_PER_PUBLISH=16

SQL__MAX_ROWS=10000
SQL__MAX_QUERY_ROWS=10000
SQL__QUERY_TIMEOUT_MS=5000

# EVERY RATE-LIMIT NUMBER LIVES IN A POLICY FILE, not in an env name. Three ship:
#   services/proxy/default_rate_limits.yml   anonymous minting CLOSED (0) — the production default
#   services/proxy/selfhost_rate_limits.yml  anonymous minting at 10/hour/ip — this one
#   services/proxy/dev_rate_limits.yml       wide open (2000), so a gate run cannot exhaust it
# Copy one and edit it to change a budget or add a route; unset means the closed default.
PROXY__RATE_LIMIT_CONFIG_FILE=services/proxy/selfhost_rate_limits.yml
RATE_LIMITER__TRUSTED_PROXY_HOPS=1

# Optional deployment controls.
# ARTIFACTS__ALLOW_PUBLIC=1
# ANALYTICS__SECRET=

# Split-service deployment. INTERNAL__SERVICE_SECRET must match across app, SQL, browser and events.
# APP__UPSTREAM_URL=http://app:3000
# CONTRACT__ACTOR_SECRET=
# BROWSER__SERVICE_URL=http://browser:8080
# INTERNAL__SERVICE_SECRET=
# SQL__SERVICE_URL=http://sql:8080
# The events service (services/events): unset, nothing leaves the box and the feed reads empty.
# EVENTS__SERVICE_URL=http://events:8080
# EVENTS__SCHEMA=events
EXPORT__INTERNAL_ORIGIN=

# Standalone proxy database schemas and forwarding behavior.
# AUTH__SCHEMA=auth
# APP__SCHEMA=app
# PROXY__SECURE_COOKIES=
# UPSTREAM__DEADLINE_MS=30000

# Optional Google login.
# AUTH__GOOGLE_CLIENT_ID=
# AUTH__GOOGLE_CLIENT_SECRET=

# Optional OIDC login. Use explicit endpoints or discovery, not both.
# AUTH__OIDC_PROVIDER_ID=oidc
# AUTH__OIDC_CLIENT_ID=
# AUTH__OIDC_CLIENT_SECRET=
# AUTH__OIDC_AUTHORIZATION_URL=
# AUTH__OIDC_TOKEN_URL=
# AUTH__OIDC_USERINFO_URL=
# AUTH__OIDC_DISCOVERY_URL=

