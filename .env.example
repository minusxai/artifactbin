# Run `npm run setup` to create `.env` for this checkout.
# It generates secure AUTH__SECRET and ADMIN__SECRET values for you.

# Shared secret for admin-minting/revoking tokens (POST /api/tokens).
# If unset, those admin endpoints answer 404. (Anonymous minting via
# /api/tokens/anonymous works regardless.)
# Generate: openssl rand -base64 32
ADMIN__SECRET=

# Secret for signing login session JWTs. Generate: openssl rand -base64 32
# Falls back to an insecure dev-only value when unset.
AUTH__SECRET=

# THE database env — the URL is the type. Unset: embedded PGLite at
# ./data/pglite (zero-config; exactly ONE server process may own that
# directory — see README). Under docker compose, unset means the bundled
# postgres service. The idempotent boot DDL applies to whatever this points
# at — your URL, your database, your schema.
# DATABASE_URL=pglite://./data/pglite
# DATABASE_URL=pglite://memory
# DATABASE_URL=postgresql://user:pass@host:5432/artifact_bin

# Used only by `npm run mint` to reach the running server.
# Unset, it follows PUBLIC_BASE_URL.
# BASE_URL=http://localhost:3030

# The externally visible origin (absolute URLs in MCP tool responses).
# Set to your real https origin in production.
# In dev this ALSO picks the port `npm run dev` binds — change it here (and
# nothing else) to run a second checkout beside the first. PORT overrides it;
# a URL with no port means 3030.
APP__PUBLIC_BASE_URL=http://localhost:3030

# Host port compose publishes the app on, and — set here — the port `npm run
# dev` binds, overriding the one in PUBLIC_BASE_URL. Default 3030 either way,
# so the two are interchangeable; only one can run at a time. Leave it unset to
# let PUBLIC_BASE_URL alone decide the dev port, or the links the app emits and
# the port it listens on can disagree (dev warns when they do).
APP__PORT=3030

# Interface the standalone proxy binds; blank binds all interfaces (default).
# APP__HOST=                        # blank = every interface (the default); set to bind one

# Vite's dev-only HMR websocket port. Unset defaults to APP__PORT + 1.
APP__HMR_PORT=

# Per-token artifact cap; creation answers 403 quota_exceeded at the cap.
# 0 disables. Default 1000.
QUOTA__ARTIFACTS_PER_TOKEN=1000

# REQUIRED for accounts. Login is email + a one-time code, so the app cannot
# sign anyone in without a way to send mail. There is deliberately NO fallback
# that prints the code to the log — that would be an auth bypass for anyone who
# can read logs. Get a key at resend.com and verify the sending domain.
EMAIL__RESEND_API_KEY=

# Sender for login codes. Must be a domain verified in Resend or sends fail.
EMAIL__FROM=artifact-bin <login@verify.artifactbin.dev>

# Resend API base — the ONE way to read a login code, since nothing in the app
# ever exposes one. Point it at a local sink and the real send path posts the
# email there as JSON instead (scripts/lib/mail-login.mjs). Each gate binds its
# own sink port, so point this at the fan-out relay and one restart covers all
# of them:  node scripts/lib/mail-relay.mjs
EMAIL__RESEND_BASE_URL=http://127.0.0.1:4600

# Object storage for dataset rows, as ONE connection string: credentials,
# bucket and top-level folder together. Percent-encode the secret — generated
# ones contain / + and =.
#   s3://KEY:SECRET@s3.<region>.amazonaws.com/<bucket>/<folder>?region=<region>
# Unset, datasets fall back to the local filesystem (LOCAL_OBJECT_DIR), so a
# laptop and CI need no external service — the same promise PGLite makes.
# S3_URL=
OBJECT_STORE__LOCAL_DIR=.artifact-objects

# Maximum bytes accepted for one uploaded image. Default 5,000,000.
IMAGES__MAX_BYTES=5000000

# Web-import safety/capacity controls: private networks stay blocked by default;
# requests time out after 10s; one identity gets 300 attempts/hour; one publish imports at most 8 images.
WEB_INGEST__ALLOW_PRIVATE=0
WEB_INGEST__TIMEOUT_MS=10000
WEB_INGEST__MAX_PER_HOUR=300
WEB_INGEST__MAX_IMAGES_PER_PUBLISH=8

# Rows kept from a data source. A dataset is a SAMPLE until there is a query
# layer: 200k rows import fine and then make an unloadable page, because every
# row is fetched, parsed and serialized into the document. The true row count is
# always reported, so truncation is never silent.
SQL__MAX_ROWS=10000

# Rows one SQL query may return (defaults to SQL__MAX_ROWS) and its 5s timeout.
SQL__MAX_QUERY_ROWS=10000
SQL__QUERY_TIMEOUT_MS=5000

# Anonymous-mint ceiling, per IP per hour (POST /api/tokens/anonymous and the
# OAuth guest grant). The window is in-memory, so a restart also clears it.
# Default 10 for a real deployment; `next dev` defaults high instead, because
# the browser gates mint on every run and would otherwise exhaust the hour.
# Setting it here wins in both.
RATE_LIMITER__ANON_MINT_MAX=10

# How many proxies sit in front of this app. X-Forwarded-For is a list each hop
# APPENDS to, so the address your outermost TRUSTED proxy saw is this many
# entries from the END — everything left of it is text the CALLER sent, and
# reading that end lets a caller pick their own rate-limit bucket.
# Default 1 = the single TLS-terminating proxy docker-compose.yml assumes.
# Set 2 if you add a CDN in front of that proxy. Never set it higher than the
# number of hops that actually rewrite the header.
RATE_LIMITER__TRUSTED_PROXY_HOPS=1

# Turn the PREVIEW features on for this whole deployment (lib/features/).
# Unset, they are opt-in per REQUEST with `?v=2` — the flag lives in the URL
# and nowhere else, and the app carries it onto its own /api/ calls and links.
# A staging box sets this; production leaves it alone until a feature ships.
# Today's previews: writable-datasets.
PREVIEW__FEATURES=1

# How many dataset writes ONE VISITOR may make per minute through documents
# (POST /a/<id>/mutate, keyed by client IP). A public writable dataset behind a
# public document is an open inbox by design — that is what a poll IS — and
# this is what keeps one script from filling it. Well clear of a human clicking.
RATE_LIMITER__MUTATE_MAX=60

# ── Namespaced names (MODULE__NAME) — the only spelling there is. A retired
# flat name is not read; the server names it and its replacement at boot. ────
# RATE LIMITER — every door has the same four knobs: _MAX, _WINDOW (seconds),
# _BURST (the multiplier a credentialed caller gets on the SAME bucket), _KEY
# (ip | actor | ip+actor). Doors: GLOBAL ANON_MINT LOGIN_SEND LOGIN_VERIFY
# PUBLISH EDIT MUTATE QUERY EXPORT EVENTS_STREAMS OAUTH_TOKEN.
# Anonymous minting is CLOSED by default (0/hour) — a self-hoster who changes
# nothing never has strangers minting on their box. The public deployment opens it:
# RATE_LIMITER__ANON_MINT_MAX=10
# RATE_LIMITER__ANON_MINT_BURST=5
# RATE_LIMITER__MUTATE_MAX=60
# RATE_LIMITER__TRUSTED_PROXY_HOPS=1
# `public` visibility (listing on profiles) is OFF by default; `unlisted` already
# gives "anyone with the link". The public deployment turns it on:
# ARTIFACTS__ALLOW_PUBLIC=1
# The analytics visitor fingerprint's own secret (defaults to AUTH__SECRET):
# ANALYTICS__SECRET=
# The browser service for export (services/browser, an HTTP service); unset = Chromium in this process:
# BROWSER__SERVICE_URL=http://browser:8080
# Shared bearer secret for split app/sql/browser deployments. The app sends it
# to both internal services, which reject operation requests when it is absent
# or wrong. Health checks remain unauthenticated. Generate: openssl rand -base64 32
# INTERNAL__SERVICE_SECRET=
# AUTH (the proxy's human login — Better Auth: email code, Google, any OIDC IdP)
# AUTH__SECRET=                      # session signing; also signs the agent cookie. Set it: a generated one forgets every session on restart.

# Where identity's tables live (Better Auth: user, session, account,
# verification). `auth` unless set. A deployment that shares ONE database
# between products — a schema each — names its own here, so a second tenant's
# identity tables never appear underneath it. Plain identifier only.
# AUTH__SCHEMA=auth
# APP__SCHEMA=app                   # app tables the proxy's token reader addresses
# PROXY__SECURE_COOKIES=            # default: true for an https public URL, otherwise false
# UPSTREAM__DEADLINE_MS=30000        # the standalone proxy's wait for the upstream's status+headers; a streaming body is never timed
# AUTH__GOOGLE_CLIENT_ID=
# AUTH__GOOGLE_CLIENT_SECRET=
# AUTH__OIDC_PROVIDER_ID=okta        # any OIDC IdP, by explicit endpoints (preferred: nothing fetched at boot) or discovery
# AUTH__OIDC_CLIENT_ID=
# AUTH__OIDC_CLIENT_SECRET=
# AUTH__OIDC_AUTHORIZATION_URL=
# AUTH__OIDC_TOKEN_URL=
# AUTH__OIDC_USERINFO_URL=
# AUTH__OIDC_DISCOVERY_URL=          # if set, fetched AT BOOT — an unreachable IdP fails the boot, loudly
# ADMIN__SECRET=                     # the operational admin secret (POST /api/tokens etc.)
# REMOTE SQL (M6): move the DuckDB engine out of this process. The service runs
# the same module under the same guards; the SQL, the params and the rows to
# register travel to it — never a document, never a credential. Unset (the
# self-host default) the engine runs in-process on the native module.
# SQL__SERVICE_URL=http://sql:8080

# Origin the export browser uses for this app; blank defaults to this process.
EXPORT__INTERNAL_ORIGIN=

# Optional client analytics; blank token disables it. Host defaults to Mixpanel's US endpoint.
MIXPANEL__TOKEN=
MIXPANEL__HOST=https://api-js.mixpanel.com
