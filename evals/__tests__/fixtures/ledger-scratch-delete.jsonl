{"t":1787845265020,"ms":356,"method":"POST","path":"/api/artifacts/cvPGM1/edits","status":200,"ua":"curl/8.5.0","auth":"bearer","error":null,"artifactId":"cvPGM1","resMarkup":"<Helmet>\n  <title>Support load, first half</title>\n  <meta name=\"description\" content=\"Operating view of support ticket volume, channel mix and resolution time, January–June 2026.\" />\n  <Value name=\"team\" type=\"string\" />\n  <Value name=\"channel\" type=\"string\" default=\"all\" />\n  <Value name=\"window\" type=\"string\" default=\"H1\" />\n  <Query name=\"teams\">{`select distinct team from ref_v2mNrg order by 1`}</Query>\n  <Query name=\"vol_trend\">{`\n    select month as period, sum(tickets) as tickets\n    from ref_v2mNrg\n    where ($team is null or team = $team)\n      and ($channel = 'all' or channel = $channel)\n      and ($window = 'H1' or (case when cast(substr(month, 6, 2) as integer) <= 3 then 'Q1' else 'Q2' end) = $window)\n    group by 1 order by 1\n  `}</Query>\n  <Query name=\"res_trend\">{`\n    select month as period,\n           round(sum(tickets * median_resolution_hours) / sum(tickets), 2) as hours\n    from ref_v2mNrg\n    where ($team is null or team = $team)\n      and ($channel = 'all' or channel = $channel)\n      and ($window = 'H1' or (case when cast(substr(month, 6, 2) as integer) <= 3 then 'Q1' else 'Q2' end) = $window)\n    group by 1 order by 1\n  `}</Query>\n  <Query name=\"kpi_total\">{`\n    select sum(tickets) as tickets\n    from ref_v2mNrg\n    where ($team is null or team = $team)\n      and ($channel = 'all' or channel = $channel)\n      and ($window = 'H1' or (case when cast(substr(month, 6, 2) as integer) <= 3 then 'Q1' else 'Q2' end) = $window)\n  `}</Query>\n  <Query name=\"chat_share\">{`\n    select round(sum(case when channel = 'chat' then tickets else 0 end) * 1.0 / sum(tickets), 4) as share\n    from ref_v2mNrg\n    where ($team is null or team = $team)\n      and ($window = 'H1' or (case when cast(substr(month, 6, 2) as integer) <= 3 then 'Q1' else 'Q2' end) = $window)\n  `}</Query>\n  <Query name=\"vol_channel\">{`\n    select month, channel, sum(tickets) as tickets\n    from ref_v2mNrg\n    where ($team is null or team = $team)\n      and ($channel = 'all' or channel = $channel)\n      and ($window = 'H1' or (case when cast(substr(month, 6, 2) as integer) <= 3 then 'Q1' else 'Q2' end) = $window)\n    group by 1, 2 order by 1, 2\n  `}</Query>\n  <Query name=\"res_team\">{`\n    select team, channel, median(median_resolution_hours) as median_hours\n    from ref_v2mNrg\n    where ($team is null or team = $team)\n      and ($channel = 'all' or channel = $channel)\n      and ($window = 'H1' or (case when cast(substr(month, 6, 2) as integer) <= 3 then 'Q1' else 'Q2' end) = $window)\n    group by 1, 2 order by 3 desc\n  `}</Query>\n  <Query name=\"detail\">{`\n    select month, team, channel, tickets, median_resolution_hours as median_hours\n    from ref_v2mNrg\n    where ($team is null or team = $team)\n      and ($channel = 'all' or channel = $channel)\n      and ($window = 'H1' or (case when cast(substr(month, 6, 2) as integer) <= 3 then 'Q1' else 'Q2' end) = $window)\n    order by month, team, channel\n  `}</Query>\n</Helmet>\n<div data-design=\"tw\" className=\"@container min-h-screen bg-background px-4 py-4 @2xl:px-6 text-foreground\">\n  <header className=\"border-b-2 border-foreground pb-3\">\n    <div className=\"flex items-baseline justify-between gap-4\">\n      <p className=\"text-xs uppercase tracking-widest font-semibold text-primary\">Support ops · 2026 H1</p>\n      <span className=\"font-mono text-[11px] uppercase tracking-wider text-muted-foreground\"><span className=\"text-primary\">●</span> live · jan–jun 2026</span>\n    </div>\n    <h1 className=\"mt-2 text-base @2xl:text-lg font-medium tracking-tight\">Chat now carries <Number data=\"$chat_share\" col=\"share\" agg=\"sum\" format=\".0%\" /> of ticket volume and clears fastest; email is where the hours go.</h1>\n  </header>\n  <div className=\"flex flex-wrap items-end gap-4 py-3\">\n    <Select label=\"Team\" value=\"$team\" options=\"$teams\" placeholder=\"All teams\" />\n    <Segmented label=\"Channel\" value=\"$channel\" options={[\"all\",\"email\",\"chat\"]} />\n    <Segmented label=\"Window\" value=\"$window\" options={[\"H1\",\"Q1\",\"Q2\"]} />\n  </div>\n  <Grid>\n    <GridItem x={0} y={0} w={5} h={3} className=\"rounded-md border border-border bg-card/50\">\n      <Question data=\"$vol_trend\" viz={{\"kind\":\"recipe\",\"recipe\":\"minusx/trend@1\",\"bindings\":{\"date\":\"period\",\"value\":[\"tickets\"]},\"params\":{\"compareMode\":\"last\"},\"columnFormats\":{\"tickets\":{\"format\":\",.0f\",\"alias\":\"Tickets per month\"}}}} />\n    </GridItem>\n    <GridItem x={5} y={0} w={4} h={3} className=\"rounded-md border border-border bg-card/50\">\n      <Question data=\"$res_trend\" viz={{\"kind\":\"recipe\",\"recipe\":\"minusx/trend@1\",\"bindings\":{\"date\":\"period\",\"value\":[\"hours\"]},\"params\":{\"compareMode\":\"last\",\"trendColor\":\"var(--chart-2)\"},\"columnFormats\":{\"hours\":{\"format\":\",.1f\",\"alias\":\"Resolution hrs\"}}}} />\n    </GridItem>\n    <GridItem x={9} y={0} w={3} h={3} className=\"rounded-md border border-border bg-card/50\">\n      <Question data=\"$kpi_total\" viz={{\"kind\":\"single_value\",\"yCols\":[\"tickets\"],\"singleValueConfig\":{\"label\":\"Tickets in window\",\"format\":\",.0f\"}}} />\n    </GridItem>\n    <GridItem x={0} y={3} w={8} h={5} className=\"rounded-md border border-border bg-card/50\">\n      <Question title=\"Volume by channel\" data=\"$vol_channel\" viz={{\"kind\":\"vega-lite\",\"spec\":{\"mark\":{\"type\":\"area\",\"line\":true,\"opacity\":0.85},\"encoding\":{\"x\":{\"field\":\"month\",\"type\":\"nominal\",\"axis\":{\"title\":null,\"labelAngle\":0}},\"y\":{\"field\":\"tickets\",\"type\":\"quantitative\",\"axis\":{\"title\":\"Tickets\"},\"stack\":\"zero\"},\"color\":{\"field\":\"channel\",\"type\":\"nominal\",\"legend\":{\"title\":null,\"orient\":\"top\"}}}}}} />\n    </GridItem>\n    <GridItem x={8} y={3} w={4} h={5} className=\"rounded-md border border-border bg-card/50\">\n      <Question title=\"Median hours by team\" data=\"$res_team\" viz={{\"kind\":\"vega-lite\",\"spec\":{\"mark\":{\"type\":\"bar\"},\"encoding\":{\"y\":{\"field\":\"team\",\"type\":\"nominal\",\"axis\":{\"title\":null}},\"x\":{\"field\":\"median_hours\",\"type\":\"quantitative\",\"axis\":{\"title\":\"Median hours\"}},\"yOffset\":{\"field\":\"channel\",\"type\":\"nominal\"},\"color\":{\"field\":\"channel\",\"type\":\"nominal\",\"legend\":{\"title\":null,\"orient\":\"top\"}}}}}} />\n    </GridItem>\n    <GridItem x={0} y={8} w={12} h={4} className=\"rounded-md border border-border bg-card/50\">\n      <DataTable data=\"$detail\" columns={[{\"col\":\"month\",\"title\":\"Month\"},{\"col\":\"team\",\"title\":\"Team\"},{\"col\":\"channel\",\"title\":\"Channel\"},{\"col\":\"tickets\",\"title\":\"Tickets\",\"fmt\":\",.0f\",\"align\":\"right\",\"bar\":true},{\"col\":\"median_hours\",\"title\":\"Median hrs\",\"fmt\":\",.1f\",\"align\":\"right\",\"colorScale\":\"sequential\"}]} sort={{\"col\":\"month\",\"dir\":\"asc\"}} />\n    </GridItem>\n  </Grid>\n  <p className=\"mt-4 font-mono text-[11px] uppercase tracking-wider text-muted-foreground\">source: support tickets 2026 h1 · ref_v2mNrg · 24 rows · month × channel × team</p>\n</div>\n"}
