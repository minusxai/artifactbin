{
  "server": {
    "portBase": 3100,
    "env": {
      "PROXY__RATE_LIMIT_CONFIG_FILE": "services/proxy/dev_rate_limits.yml",
      "QUOTA__ARTIFACTS_PER_TOKEN": "0",
      "WEB_INGEST__ALLOW_PRIVATE": "1"
    }
  },
  "run": {
    "maxTurns": 40,
    "concurrency": 4,
    "maxBudgetUsd": 3,
    "timeoutMs": 900000
  },
  "capture": {
    "sizes": [
      "laptop",
      "mobile"
    ],
    "renderers": [
      "export",
      "playwright"
    ]
  }
}
