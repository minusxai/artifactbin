node_modules/
.next/
/data/
.env
.env.*
!.env.example
*.tsbuildinfo
next-env.d.ts
# vendored runtime assets — copied from node_modules on postinstall
**/public/monaco/
# generated plugin for local `claude --plugin-dir ./plugin` (npm run build:plugin);
# published to the public mirror repo by CI, never committed here
/plugin/
.artifact-objects/
tmp/
**/public/story/
**/lib/story-runtime/dist/
**/public/fonts/
**/lib/data/story/story-font-manifest.json
# landing illustration SOURCES — 1254px PNG, ~2.8 MB each, 34 MB for the set.
# Nothing serves them: the page references only the WebP that
# scripts/optimise-landing-art.mjs derives from them, and those ARE committed.
# Kept on disk rather than deleted, because they are the only thing the
# renderings can be regenerated from if a size or a crop ever changes.
**/public/landing/*.png

# agent evals: run output (rows, screenshots, transcripts)
# Every run directory, not just the default one: `--out evals/.metrics-pi` is how two
# local legs avoid clobbering each other, and a bare `evals/.metrics/` let 139 files of
# transcripts and ledgers into a commit via `git add -A`.
evals/.metrics*/

# Build output — the image builds these; they are never committed.
/dist/
services/app/dist/
services/app/data/
