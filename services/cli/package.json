{
  "name": "@artifactbin/cli",
  "version": "0.2.5",
  "type": "module",
  "license": "Apache-2.0",
  "description": "Local files, published artifacts and agent authoring",
  "bin": {
    "afbin": "dist/afbin.mjs"
  },
  "exports": {
    ".": {
      "types": "./dist/types/cli/src/index.d.ts",
      "import": "./dist/index.mjs"
    }
  },
  "files": [
    "dist/afbin.mjs",
    "dist/index.mjs",
    "dist/types",
    "scripts/prepare-pty.mjs",
    "dist/skills",
    "dist/share",
    "dist/runtime"
  ],
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "test": "node --import tsx --test test/*.test.ts",
    "build:binary": "node scripts/binary.mjs",
    "postinstall": "node scripts/prepare-pty.mjs",
    "test:binary": "node scripts/test-local-binary.mjs && node scripts/test-binary.mjs",
    "generate:teaching": "node scripts/generate-teaching.mjs",
    "pretest": "node scripts/generate-teaching.mjs"
  },
  "dependencies": {
    "@xterm/addon-serialize": "0.14.0",
    "@xterm/headless": "6.0.0",
    "diff": "^8.0.4",
    "marked": "18.0.12",
    "yaml": "^2.9.0",
    "@artifactbin/sql": "*",
    "pg": "8.17.1",
    "@electric-sql/pglite": "0.4.6",
    "playwright": "1.62.1",
    "playwright-core": "1.62.1",
    "vega": "6.3.1",
    "vega-lite": "6.4.3",
    "vega-interpreter": "2.3.1",
    "nunjucks": "3.2.4",
    "sharp": "0.35.4"
  },
  "devDependencies": {
    "postject": "1.0.0-alpha.6"
  },
  "types": "./dist/types/cli/src/index.d.ts",
  "optionalDependencies": {
    "node-pty": "1.1.0"
  },
  "man": [
    "dist/share/man/man1/afbin.1"
  ]
}
