    "./shape": "./src/shape.ts",
    "./dataset-grants": "./src/dataset-grants.ts",
    "./dataset-policy": "./src/dataset-policy.ts",
    "./artifact-reference": "./src/artifact-reference.ts",
    "./account-resource": "./src/account-resource.ts",
    "./escape": "./src/escape.ts",
    "./sha256": "./src/sha256.ts",
    "./runtime-id": "./src/runtime-id.ts",
    "./node/credentials": "./src/credentials.ts",
    "./node/state-lock": "./src/state-lock.ts",
    "./node/private-directory": "./src/private-directory.ts"
  },
  "files": [
    "src"
  ],
  "dependencies": {
    "@artifactbin/contracts": "*",
    "hono": "4.13.7",
    "@hono/node-server": "2.1.1"
