{
  "name": "@artifactbin/app",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./src/main.ts",
  "types": "./src/main.ts",
  "scripts": {
    "build": "node scripts/build-story-runtime.mjs && node scripts/generate-routes.mjs && vite build --config ../../vite.config.mts",
    "build:runtime": "node scripts/build-story-runtime.mjs",
    "generate:routes": "node scripts/generate-routes.mjs",
    "test": "vitest run --config ../../vitest.config.ts --project=api && vitest run --config ../../vitest.config.ts --project=node && vitest run --config ../../vitest.config.ts --project=ui",
    "test:api": "vitest run --config ../../vitest.config.ts --project=api",
    "test:node": "vitest run --config ../../vitest.config.ts --project=node",
    "test:ui": "vitest run --config ../../vitest.config.ts --project=ui",
    "validate": "tsc --noEmit -p ../../tsconfig.json",
    "postinstall": "node scripts/copy-assets.mjs",
    "generate-story-ui-classes": "tsx scripts/generate-story-ui-classes.ts",
    "build:plugin": "tsx -r ../../scripts/register-yaml.cjs scripts/build-plugin.ts",
    "generate:theme-previews": "tsx -r ../../scripts/register-yaml.cjs scripts/generate-theme-previews.ts",
    "generate:og": "tsx scripts/generate-og-image.ts"
  },
