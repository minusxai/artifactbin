PAGEGI_PASSWORD_LOGIN=false
# Never set PAGEGI_TEST_LOGIN in production; the server refuses to start with it.
# Optional: other origins rewritten to this server when pages are saved.
# PAGEGI_KNOWN_ORIGINS=https://pages.example
PAGEGI_RESEND_API_KEY=replace-with-provider-key
# The display name is sent exactly as configured; use your verified sender address.
PAGEGI_EMAIL_FROM=Artifactbin <login@example.com>
PAGEGI_DATABASE_URL=postgres://pagegi:replace-with-password@postgres:5432/pagegi
# Trusted platform and separate per-document runner domain; configure wildcard DNS/TLS.
PAGEGI_PLATFORM_ORIGIN=https://app.example.com
PAGEGI_RUNNER_ORIGIN=https://{document}.runner.example.net
# Optional, only on an execution host with a Docker daemon and the built sandbox image.
# The web Compose service intentionally has no Docker socket or execution authority.
# PAGEGI_BACKEND_EXECUTOR=docker
# PAGEGI_BACKEND_IMAGE=pagegi-backend:local
# Recommended: fixed execution service transport; the web process needs no Docker access.
# PAGEGI_BACKEND_EXECUTOR=remote
# PAGEGI_EXECUTION_SOCKET=/run/pagegi/execution.sock
# Alternative fixed endpoint (mutually exclusive with socket):
# PAGEGI_EXECUTION_ENDPOINT=https://executor.example.net/v1/execute
# PAGEGI_EXECUTION_SECRET_FILE=/run/secrets/pagegi_execution
# A deployment-owned JSON resource file; never use an app-provided path.
# PAGEGI_RESOURCE_CONFIG=/etc/pagegi/resources.json
# No resource grants are inferred. Each grant pins documentId, backendVersion
# (exact 64-character hash), resource, and namedOperations. Redeployments require
# explicit grants for the new version. Tenant is the authenticated document ID.
# File shape: {"resources":{},"grants":[]}
# HTTP resource: {"kind":"http","origin":"https://api.example.net",
#   "tokenEnv":"RESOURCE_API_TOKEN","operations":{"lookup":{"method":"POST","path":"/lookup"}}}
# PostgreSQL resource: {"kind":"postgres","connectionStringEnv":"RESOURCE_DATABASE_URL",
#   "operations":{"lookup":{"text":"SELECT value FROM records WHERE tenant=$1 AND id=$2",
#   "params":[{"from":"tenant"},{"from":"input","path":["id"]}]}}}
# Params select tenant, subject, or own JSON input paths; missing paths become null.
# Pools own at most eight connections, with bounded acquisition/query timeouts.
# Referenced credentials are read from environment names, never embedded in HTML.
# Optional dataset event routes (independent of backend version grants):
# "effects":[{"documentId":"document-id","resource":"api","operation":"deliver","idempotent":true}]
# At most one exact route per document. The named destination must durably
# deduplicate delivery keys; this assertion never authorizes resolver replay.
