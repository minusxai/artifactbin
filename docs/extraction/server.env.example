# Team host settings for `afbin serve --config <this file>` (mode 0600).
#
# This is NOT the repository's `.env.example`: copying that one fails at startup with
# `Unsupported team setting: OBJECT_STORE__LOCAL_DIR`. `teamSettings` accepts `DATABASE_URL`
# and `MODULE__NAME` settings whose module is one of APP, AUTH, EMAIL, ADMIN, ANALYTICS,
# ARTIFACTS, ASSETS, BROWSER, DATASET, EVENTS, EXPORT, FILES, IMAGES, INTERNAL, PDF, QUOTA,
# SQL or WEB_INGEST. RUNNER__SERVICE_URL and CONTRACT__ACTOR_SECRET are the only
# remote-runner exceptions; other `*__SERVICE_URL`, APP__UPSTREAM_URL and namespaces are refused.
# Object storage, the runtime home and the client state directory are set by serve itself
# from `--dir`, so naming them here is refused rather than honoured.
# Lines are plain NAME=value: no quoting, no `export`, no shell expansion.

# Required.
APP__HOST=0.0.0.0
APP__PORT=7445
APP__PUBLIC_BASE_URL=https://artifacts.example.com
APP__DEPLOYMENT_MODE=company
APP__DEPLOYMENT_OWNER_EMAIL=owner@example.com
# Owner verifies this email, selects/creates an editor group and confirms deployment setup.
# Invite colleagues to that company group before sign-in; document shares do not admit accounts.
AUTH__INVITE_ONLY=true
# Comma-separated email globs. Invitations and the owner must also match; default is *.
AUTH__ALLOWED_EMAIL_PATTERNS=*@example.com
AUTH__SECRET=<persistent random secret of at least 32 characters>

# Documents are served on their own origins, <id>.<pages host>, on the public URL's site.
# Unset: pages.<public hostname> (lvh.me for a loopback public URL); an IP-address public URL
# must set it. DNS and TLS must cover the pages host and *.<pages host>.
#APP__PAGES_HOST=pages.artifacts.example.com

# A COMPLETE login method is required whenever APP__PUBLIC_BASE_URL is not loopback, and a
# half-configured one is refused at startup rather than served: EMAIL__SMTP_HOST and
# EMAIL__FROM with valid TLS/port and paired credentials, or EMAIL__RESEND_API_KEY *and*
# EMAIL__FROM (the key alone leaves the sender at a default address no provider will send for),
# or both Google settings, or OIDC with a client id, a client secret and either the discovery
# URL or all three explicit endpoints. SMTP is an alternative to Resend, not an additional provider.
# Choose ONE email transport. SMTP uses TLS certificate verification.
#EMAIL__RESEND_API_KEY=<mail provider credential>
EMAIL__SMTP_HOST=smtp.example.com
EMAIL__SMTP_PORT=587
EMAIL__SMTP_SECURE=false
EMAIL__SMTP_USER=<SMTP username>
EMAIL__SMTP_PASSWORD=<SMTP password>
# Default port 587 requires STARTTLS. SECURE=true uses implicit TLS, default port 465.
# USER/PASSWORD must be paired; omit both only for a trusted TLS relay.
EMAIL__FROM=Artifactbin <login@example.com>
#AUTH__GOOGLE_CLIENT_ID=
#AUTH__GOOGLE_CLIENT_SECRET=
#AUTH__OIDC_PROVIDER_ID=
#AUTH__OIDC_CLIENT_ID=
#AUTH__OIDC_CLIENT_SECRET=
#AUTH__OIDC_DISCOVERY_URL=                                      # …or AUTH__OIDC_{AUTHORIZATION,TOKEN,USERINFO}_URL

# Optional.
#DATABASE_URL=postgres://user:password@localhost/artifactbin   # default: pglite under <dir>/data
#EMAIL__DEV_OUTBOX_PATH=data/outbox.jsonl                      # loopback origins only; relative to THIS file (not --dir)
#SQL__MAX_QUERY_ROWS=300

# Optional Lambda execution: a separate runner controller, with a matching signing secret.
# See ../../services/runner/README.md. Worker images and AI keys belong on the controller.
#RUNNER__SERVICE_URL=http://runner:3050
#CONTRACT__ACTOR_SECRET=<32+ random characters shared with the trusted controller>
