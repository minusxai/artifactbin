# Team host settings for `afbin serve --config <this file>` (mode 0600).
#
# This is NOT the repository's `.env.example`: copying that one fails at startup with
# `Unsupported team setting: OBJECT_STORE__LOCAL_DIR`. `teamSettings` accepts `DATABASE_URL`
# and `MODULE__NAME` settings whose module is one of APP, AUTH, EMAIL, ADMIN, ANALYTICS,
# ARTIFACTS, ASSETS, BROWSER, DATASET, EVENTS, EXPORT, FILES, IMAGES, INTERNAL, PDF, QUOTA,
# SQL or WEB_INGEST — never a `*__SERVICE_URL`, `APP__UPSTREAM_URL` or any other namespace.
# Object storage, the runtime home and the client state directory are set by serve itself
# from `--dir`, so naming them here is refused rather than honoured.
# Lines are plain NAME=value: no quoting, no `export`, no shell expansion.

# Required.
APP__HOST=0.0.0.0
APP__PORT=7445
APP__PUBLIC_BASE_URL=https://artifacts.example.com
AUTH__SECRET=<persistent random secret of at least 32 characters>

# A login method is required whenever APP__PUBLIC_BASE_URL is not loopback: a Resend key,
# Google, or OIDC. There is no SMTP option.
EMAIL__RESEND_API_KEY=<mail provider credential>
EMAIL__FROM=Artifactbin <login@example.com>
#AUTH__GOOGLE_CLIENT_ID=
#AUTH__GOOGLE_CLIENT_SECRET=
#AUTH__OIDC_PROVIDER_ID=
#AUTH__OIDC_CLIENT_ID=
#AUTH__OIDC_CLIENT_SECRET=
#AUTH__OIDC_DISCOVERY_URL=

# Optional.
#DATABASE_URL=postgres://user:password@localhost/artifactbin   # default: pglite under <dir>/data
#EMAIL__DEV_OUTBOX_PATH=data/outbox.jsonl                      # loopback origins only; relative to this file
#SQL__MAX_QUERY_ROWS=300
