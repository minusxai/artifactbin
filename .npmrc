# `npm ci` INSTALLS A PINNED LOCKFILE — it must not wait on a third-party
# advisory service to do it.
#
# Every install otherwise ends by POSTing the whole dependency list to npm's
# advisory endpoint and BLOCKING on the reply, then retrying twice. When that
# endpoint degraded on 2026-09-04 (120s hang → 503, or a 220s answer), this
# repo's install went from ~15s to 421s, ten times over in the `image` job,
# which was cancelled at its 30-minute cap. The verdict could not have changed
# what was installed — the lockfile is pinned — and nothing in CI reads it.
# Run `npm audit` on its own when you want the signal.
#
# Checked out, so this reaches local dev and every CI runner with nothing to
# remember. It does NOT reach the Docker builds: no stage copies it, and a COPY
# would have to be repeated per stage. There the flag rides the command itself
# — see the `--no-audit` on every `npm ci`, guarded by
# services/app/lib/__tests__/npm-ci-no-audit.test.ts.
audit=false

# The funding footer is a second registry-shaped read of the tree for output
# nobody scrolls back to in a CI log.
fund=false
