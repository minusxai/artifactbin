{
  "name": "artifactbin",
  "private": true,
  "type": "module",
  "version": "0.1.0",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "release:cli": "node scripts/bump-cli-version.mjs",
    "setup": "node scripts/setup.mjs",
    "dev": "node scripts/dev.mjs",
    "dev:otp": "node scripts/dev-otp.mjs",
    "dev:app": "node scripts/dev-app.mjs",
    "build": "npm run build -w services/app && node scripts/build-server.mjs dist/proxy-server.mjs",
    "validate": "node scripts/check-local.mjs validate",
    "test": "node scripts/check-local.mjs test",
    "test:all": "npm test -w services/app && npm test -w services/cli",
    "test:integration": "vitest run --project=integration",
    "build:runtime": "npm run build:runtime -w services/app",
    "test:api": "npm run test:api -w services/app",
    "test:node": "npm run test:node -w services/app",
    "test:ui": "npm run test:ui -w services/app",
    "test:gates": "node scripts/gates.mjs",
    "generate-story-ui-classes": "npm run generate-story-ui-classes -w services/app",
    "generate:theme-previews": "npm run generate:theme-previews -w services/app",
    "generate:og": "npm run generate:og -w services/app",
    "eval": "tsx evals/run.ts",
    "eval:report": "tsx evals/report-cli.ts",
    "generate:routes": "npm run generate:routes -w services/app",
    "render:schema": "node scripts/render-schema.mjs",
    "generate:env-snapshot": "node scripts/generate-env-snapshot.mjs"
  },
  "dependencies": {
    "@artifactbin/browser": "0.1.0",
    "@artifactbin/contracts": "0.1.0",
    "@artifactbin/events": "0.1.0",
    "@artifactbin/proxy": "0.1.0",
    "@artifactbin/sql": "0.1.0",
    "@artifactbin/utils": "0.1.0",
    "@electric-sql/pglite": "0.4.6",
    "@hono/node-server": "2.1.1",
    "better-auth": "1.7.2",
    "hono": "4.13.5",
    "kysely": "0.28.17",
    "pg": "8.17.1",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "vega": "6.3.1"
  },
  "devDependencies": {
    "@rollup/plugin-yaml": "^5.0.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^22.13.0",
    "@types/pg": "^8.16.0",
    "@vitejs/plugin-react": "^6.0.5",
    "esbuild": "^0.28.2",
    "jsdom": "^30.0.1",
    "tailwindcss": "4.2.1",
    "tsx": "^4.23.11",
    "typescript": "^5",
    "vite": "^8.2.2",
    "vitest": "^4.1.5",
    "yaml": "^2.9.0",
    "zod": "4.5.2"
  },
  "workspaces": [
    "services/contracts",
    "services/utils",
    "services/app",
    "services/sql",
    "services/browser",
    "services/events",
    "services/proxy",
    "services/cli"
  ]
}
