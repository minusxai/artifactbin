{
  "name": "artifactbin",
  "private": true,
  "type": "module",
  "version": "0.1.0",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "release:cli": "node scripts/bump-cli-version.mjs",
    "setup": "node scripts/setup.mjs",
    "dev": "node scripts/dev.mjs",
    "dev:otp": "node scripts/dev-otp.mjs",
    "dev:app": "node scripts/dev-app.mjs",
    "afbin": "node scripts/afbin.mjs",
    "build": "npm run build -w services/app && node scripts/build/build-server.mjs dist/server.mjs",
    "validate": "node scripts/ci/check-local.mjs validate",
    "test": "node scripts/ci/check-local.mjs test",
    "test:all": "npm run test:api && npm run test:node && npm run test:ui && npm run test:islands && npm test -w services/cli",
    "test:integration": "vitest run --project=integration",
    "test:api": "npm run test:api -w services/app",
    "test:node": "npm run test:node -w services/app",
    "test:ui": "npm run test:ui -w services/app",
    "test:islands": "vitest run --project=islands",
    "test:gates": "node scripts/gates.mjs",
    "generate-story-ui-classes": "npm run generate-story-ui-classes -w services/app",
    "generate:og": "npm run generate:og -w services/app",
    "eval": "tsx evals/run.ts",
    "eval:report": "tsx evals/report-cli.ts",
    "generate:routes": "npm run generate:routes -w services/app",
    "render:schema": "node scripts/render-schema.mjs",
    "generate:env-snapshot": "node scripts/generate-env-snapshot.mjs",
    "generate:design-systems": "node scripts/design-systems.mjs",
    "postinstall": "node services/cli/scripts/generate-teaching.mjs",
    "generate:design-system-previews": "node scripts/generate-design-system-previews.mjs"
  },
  "dependencies": {
    "@artifactbin/auth": "0.1.0",
    "@artifactbin/browser": "0.1.0",
    "@artifactbin/contracts": "0.1.0",
    "@artifactbin/events": "0.1.0",
    "@artifactbin/sql": "0.1.0",
    "@artifactbin/utils": "0.1.0",
    "@electric-sql/pglite": "0.4.6",
    "@hono/node-server": "2.1.1",
    "better-auth": "1.7.2",
    "hono": "4.13.7",
    "kysely": "0.28.17",
    "pg": "8.17.1",
    "@artifactbin/runner": "0.1.0"
  },
  "devDependencies": {
    "@babel/core": "7.29.7",
    "@rollup/plugin-yaml": "5.0.0",
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "^22.13.0",
    "@types/pg": "8.16.0",
    "@typescript/native-preview": "7.0.0-dev.20260707.2",
    "babel-preset-solid": "1.9.15",
    "esbuild": "0.28.2",
    "jsdom": "30.0.1",
    "picomatch": "4.0.7",
    "playwright": "1.62.1",
    "sharp": "0.35.5",
    "tailwindcss": "4.2.1",
    "tsx": "4.23.11",
    "typescript": "5.9.3",
    "vite": "8.2.2",
    "vite-plugin-solid": "2.11.14",
    "vitest": "4.1.11",
    "yaml": "2.9.0"
  },
  "workspaces": [
    "services/contracts",
    "services/utils",
    "services/app",
    "services/sql",
    "services/browser",
    "services/events",
    "services/auth",
    "services/cli",
    "services/test-support",
    "services/runner",
    "docs/proposals/runner-validation"
  ],
  "overrides": {
    "seroval": "1.6.3",
    "seroval-plugins": "1.6.3",
    "katex": "0.18.2",
    "lodash-es": "4.18.0"
  }
}
