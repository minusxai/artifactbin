{
  "name": "pagegi",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "build": "node scripts/build.js",
    "build:af": "node scripts/build-skill-scripts.mjs",
    "build:image-processor": "docker build -f src/media/image-processing/container/Dockerfile -t pagegi-image-processor:local .",
    "build:backend": "docker build -t pagegi-backend:local src/backend/container",
    "start": "node src/server-main.js",
    "check": "npm run validate && npm run test:all-node",
    "validate": "node scripts/ci/validate.ts",
    "typecheck": "node scripts/ci/validate.ts",
    "test": "node scripts/testing/run.ts unit",
    "test:unit": "node scripts/testing/run.ts unit",
    "test:local": "node --import tsx scripts/testing/run.ts local",
    "test:database": "node --import tsx scripts/testing/run.ts database",
    "test:browser": "node --import tsx scripts/testing/run.ts browser",
    "test:isolate": "node --import tsx scripts/testing/run.ts isolate",
    "test:integration": "node --import tsx scripts/testing/run.ts integration",
    "test:all-node": "node --import tsx scripts/testing/run.ts all",
    "test:v2": "node scripts/testing/run.ts v2:unit",
    "test:v2:local": "node --import tsx scripts/testing/run.ts v2:local",
    "test:v2:database": "node --import tsx scripts/testing/run.ts v2:database",
    "test:v2:browser": "node --import tsx scripts/testing/run.ts v2:browser",
    "test:v2:isolate": "node --import tsx scripts/testing/run.ts v2:isolate",
    "test:v2:all": "node --import tsx scripts/testing/run.ts v2",
    "build:dataset-sql": "docker build -f src/datasets/sql/container/Dockerfile -t pagegi-dataset-sql:local .",
    "test:migration-required": "node --import tsx scripts/testing/run.ts required-migration"
  },
  "dependencies": {
    "@sqlite.org/sqlite-wasm": "3.53.4-build1",
    "acorn": "8.15.0",
    "css-tree": "3.1.0",
    "d3-format": "3.1.2",
    "graphql": "16.11.0",
    "parse5": "7.3.0",
    "pg": "8.16.3",
    "ws": "8.22.0"
  },
  "devDependencies": {
    "@types/d3-format": "3.0.4",
    "@types/node": "22.18.12",
    "acorn-jsx": "5.3.2",
    "esbuild": "0.25.12",
    "playwright": "1.56.1",
    "prettier": "3.6.2",
    "tsx": "4.20.6",
    "typescript": "5.9.3"
  }
}
