# The PROXY's settings — identity, the doors, the mailer.
#
# This committed example is what docker-compose.lean.yml loads as the proxy's
# env_file: edit it, or copy it somewhere your own compose file points. The
# secrets (AUTH__SECRET, CONTRACT__ACTOR_SECRET) do NOT live here — they come
# from the .env beside the compose file, because two processes must agree on
# CONTRACT__ACTOR_SECRET and a per-service file is where that drifts.

# The URL humans reach this proxy on (login's baseURL). Must match the
# published port in docker-compose.lean.yml (LEAN_PROXY_PORT).
APP__PUBLIC_BASE_URL=http://localhost:5440

# THE DOORS — a credential raises a ceiling, it never removes it. The
# anonymous-mint door default in production is 0 (closed); this fixture opens
# it the way the CI image boot does, so `POST /api/start` works for an agent
# with no account. Close it (0) for a deployment that wants accounts only.
RATE_LIMITER__ANON_MINT_MAX=500

# Cookies carry Secure when APP__PUBLIC_BASE_URL is https — leave unset for
# the localhost default.
# PROXY__SECURE_COOKIES=

# Maximum wait for the app's response status and headers. The timer stops
# before a streaming response body is read.
# UPSTREAM__DEADLINE_MS=30000

# Optional login providers. Google needs both values. OIDC is enabled by its
# provider id and may use explicit endpoints or discovery.
# AUTH__GOOGLE_CLIENT_ID=
# AUTH__GOOGLE_CLIENT_SECRET=
# AUTH__OIDC_PROVIDER_ID=
# AUTH__OIDC_CLIENT_ID=
# AUTH__OIDC_CLIENT_SECRET=
# AUTH__OIDC_AUTHORIZATION_URL=
# AUTH__OIDC_TOKEN_URL=
# AUTH__OIDC_USERINFO_URL=
# AUTH__OIDC_DISCOVERY_URL=
