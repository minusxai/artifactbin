# THE EVENTS SERVICE — the log of what happened, in a schema of its own.
# Copied per service by docker-compose.lean.yml's `env_file`. Everything a
# deployer chooses lives here; the container-to-container values (the database
# URL, the schema and the shared service secret) are set in `environment:`,
# where they name compose services and cannot be pointed elsewhere by a
# copy-pasted env file.

# The port the shell serves on inside the container. The image already sets it;
# it is spelled here so the file documents the whole surface.
APP__PORT=8080

# Bind every interface: the container's address is its compose service name.
APP__HOST=0.0.0.0
