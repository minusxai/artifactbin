# The APP's settings — the document tree, quotas and visibility.
#
# Loaded by docker-compose.lean.yml as the app's env_file. The
# container-to-container URLs (SQL__SERVICE_URL, BROWSER__SERVICE_URL,
# EXPORT__INTERNAL_ORIGIN) and DATABASE_URL are set in the compose file
# itself and CANNOT be overridden here — they name compose services.

# The URL links are minted from — the PROXY's public address, not the app's
# container address. Keep it in step with infra/env/proxy.env.example.
APP__PUBLIC_BASE_URL=http://localhost:5440

# Anonymous tokens may create PUBLIC documents. The OSS default is closed
# (anonymous artifacts would be born private, which without an account is a
# 400, never a silent downgrade); this fixture opens it the way the CI image
# boot does so the anonymous walk can publish. Set 0 to close.
ARTIFACTS__ALLOW_PUBLIC=1

# Object storage: unset = the app container's local dir (the compose file
# volumes it). With the compose file's `laptop` profile (MinIO), point this at
# it — credentials + bucket + top-level folder in one URL:
#   S3_URL=http://minioadmin:minioadmin@minio:9000/artifacts/lean
# S3_URL=

# Row caps for the SQL the documents declare.
# SQL__MAX_ROWS=10000
# SQL__MAX_QUERY_ROWS=10000
